# Cloud Functions environment — TEMPLATE (names only, never real values).
#
# Real files (git-ignored), ONE self-contained file per Firebase project:
#   functions/.env.handyman-sg-3b418   → prod   (firebase deploy -P prod)
#   functions/.env.eazydone-d06cf      → dev    (firebase deploy -P dev)
# Firebase loads only `.env` and `.env.<projectId>`; we deliberately keep NO
# shared functions/.env so a value can never silently apply to both projects.
# See docs/setup/environment-setup.md ("Which env file is which").

# ── App URLs ──────────────────────────────────────────────────────────────
APP_URL=https://www.example.com              # frontend origin; used in WhatsApp links
HANDYMAN_APP_BASE_URL=https://www.example.com # plain-text new-job link fallback
HOSTING_URL=                                  # optional — extra CORS origin
CORS_ALLOWED_ORIGINS=                         # optional — comma-separated extra origins

# ── Stripe (sk_test_… on dev, sk_live_… on prod) ─────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Handyman approval links ──────────────────────────────────────────────
APPROVAL_SECRET=

# ── Twilio WhatsApp ──────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+65XXXXXXXX
# Template Content SIDs (HX…). Unset → freeform fallback (24h window only).
TWILIO_TEMPLATE_JOB_CREATED=
TWILIO_TEMPLATE_JOB_ACCEPTED=
TWILIO_TEMPLATE_JOB_COMPLETION=
TWILIO_TEMPLATE_HANDYMAN_NEW_JOB=
TWILIO_TEMPLATE_HANDYMAN_CANCELLED=
TWILIO_TEMPLATE_PAYMENT_RELEASED=
TWILIO_TEMPLATE_SCHEDULE_PROPOSAL=
TWILIO_TEMPLATE_SCHEDULE_LINK=
TWILIO_TEMPLATE_SCHEDULE_PICK_APPROVAL=
TWILIO_TEMPLATE_SCHEDULE_CONFIRMED=
TWILIO_TEMPLATE_PROMPT_NUDGE=
TWILIO_TEMPLATE_SECOND_VISIT_PROPOSAL=
TWILIO_TEMPLATE_SECOND_VISIT_NEEDED=
TWILIO_TEMPLATE_VISIT_DISPOSITION=
TWILIO_TEMPLATE_ACCESS_ISSUE=
TWILIO_TEMPLATE_VISIT_PROBLEM=
TWILIO_TEMPLATE_NO_SHOW_CHOICE=
TWILIO_TEMPLATE_NO_SHOW_REPORTED=
TWILIO_TEMPLATE_PRICE_ADJUSTMENT=
TWILIO_TEMPLATE_ADJUSTMENT_PAID=
# 'button' when second_visit_needed / visit_disposition templates carry the
# link in a URL button (send job-id suffix only); omit for in-body links.
TWILIO_TEMPLATE_LINK_MODE=
# Base baked into the price_adjustment template's URL button; omit if the
# link is in the body. e.g. https://checkout.stripe.com/c/pay/
TWILIO_PRICE_ADJUSTMENT_LINK_BASE=

# ── Admin email alerts (Gmail: SMTP_PASS = 16-char App password) ─────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=

# ── New-job fan-out tuning (all optional; defaults in notificationConfig.js)
NOTIFY_ENABLED=                    # "false" disables fan-out
NOTIFY_FANOUT_CAP=                 # default 20
NOTIFY_MAX_PER_HANDYMAN_PER_HOUR=  # default 5
NOTIFY_FILTER_BY_SERVICE_TYPE=     # "true" = only matching trades get WhatsApp

# GCLOUD_PROJECT / GCP_PROJECT / PROJECT_ID are set by Google at runtime — do not set.
